# Copie para .streamlit/secrets.toml (local) ou cole em "Secrets" no Streamlit Cloud / variáveis de ambiente no Render.
# Tudo é opcional.

# Banco. Sem isto usa SQLite local (data/app.db), que é APAGADO em hospedagens grátis a cada reinício.
# Para persistir de verdade, crie um banco grátis (Neon ou Supabase) e cole a string de conexão:
# DATABASE_URL = "postgresql://usuario:senha@host/banco?sslmode=require"

# Exige senha para abrir o app (recomendado se o site for público e salvar a carteira).
# APP_PASSWORD = "troque-isto"

# IA: se definida aqui, a tela não pede a chave.
# GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-2.5-flash"

# brapi (reserva de cotações): token gratuito aumenta a confiabilidade.
# BRAPI_TOKEN = ""
